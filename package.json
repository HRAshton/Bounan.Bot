{
  "name": "bounan-bot",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint-fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage.enabled=false",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui --project app",
    "test:app": "vitest run --coverage --project app",
    "test:integration": "vitest run packages/integration-tests/tests --coverage.enabled=false",
    "dependencies:check": "pnpm outdated --recursive --use-stderr",
    "dependencies:update": "pnpm update --recursive --latest",
    "licenses:scan": "pnpm licenses list --prod --json > thirdparty.json",
    "licenses:generate": "pnpm run -w licenses:scan && node scripts/format-thirdparty.mjs",
    "textgen": "pnpm -r --filter app textgen",
    "cdk:synth": "pnpm -r --filter infra cdk:synth",
    "cdk:diff": "pnpm -r --filter infra cdk:diff",
    "cdk:deploy": "pnpm -r --filter infra cdk:deploy",
    "all-commited": "git diff --exit-code && git diff --cached --exit-code",
    "prerelease": "pnpm run -w textgen && npm-run-all2 --parallel typecheck lint test:ci knip && pnpm run -w all-commited && echo 'All checks passed!'"
  },
  "type": "module",
  "license": "BSD-3-Clause",
  "keywords": [],
  "author": {
    "name": "HRAshton"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "npm-run-all2": "catalog:",
    "vitest": "catalog:"
  }
}
